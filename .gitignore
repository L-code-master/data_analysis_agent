logs/
tmp/
temp/
.piptmp/
.pylibs/

# --- 备份 ---
*.bak
*.backup
*~

# --- 会话与产物（含客户数据，绝不提交）---
.agent/
artifacts/

# --- 本地私有资料（不上传）---
