# ============================================================================
# 企业生产级数据分析 Agent —— 配置模板
# ============================================================================
# 复制为 .env 后填写真实值。.env 已在 .gitignore 中，禁止提交。
# 生产环境请使用密钥管理服务注入，不要落地明文文件。
# ============================================================================

# ---------------------------------------------------------------------------
# 运行环境
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_DEBUG=true                      # 生产必须 false
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_BASE_URL=http://127.0.0.1:8000  # 生产改为 https://your-domain.com

# ---------------------------------------------------------------------------
# LLM（OpenAI 兼容协议端点 · 示例为千问系列）
# ---------------------------------------------------------------------------
# 填写你的 OpenAI 兼容服务地址与 Key
LLM_API_KEY=
LLM_BASE_URL=https://your-llm-endpoint.example.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_MODEL_HEAVY=qwen3.8-max     # 复杂归因用
LLM_CONTEXT_WINDOW=262144
LLM_MAX_OUTPUT=16384
LLM_TIMEOUT_SECONDS=60                # 单次调用超时（P1-13）
AGENT_MAX_DURATION_SECONDS=300        # 一次 Agent 循环整体 deadline
AGENT_MAX_COST_USD=0.10               # 一次 Agent 循环成本上限

# ---------------------------------------------------------------------------
# 成本熔断
# ---------------------------------------------------------------------------
DIAGNOSIS_MAX_COST_USD=0.05         # 单次诊断
TENANT_MONTHLY_COST_USD=5.00        # 单租户月度上限（超限拒绝服务）

# ---------------------------------------------------------------------------
# 存储
# ---------------------------------------------------------------------------
# 应用元数据（租户/用户/订单/任务）
DATABASE_URL=sqlite:///./data/app.db
# 语义层（每租户一个文件，存放于 tenants/{id}/semantic.duckdb）
SEMANTIC_SCHEMA_PATH=./semantic/schema.sql
TENANTS_ROOT=./tenants

# ---------------------------------------------------------------------------
# 上传限制
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=50
ALLOWED_UPLOAD_EXT=.xlsx,.csv

# ---------------------------------------------------------------------------
# 沙箱（安全边界，生产环境禁止改动）
# ---------------------------------------------------------------------------
# 必须为 true：客户经营数据不得出网
SANDBOX_NETWORK_ISOLATED=true
SANDBOX_MODE=accept                 # ask | accept | bypass | plan（生产建议 accept）
UPLOAD_CONFIRM_TIMEOUT=30           # 人工确认超时（秒），超时按拒绝处理

# ---------------------------------------------------------------------------
# 认证
# ---------------------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15      # 短有效期；前端自动用 refresh 续期
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5                # 连续失败锁定
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# 计费 —— 简化定价（少且可控）
# ---------------------------------------------------------------------------
# 产品形态：按次付费为主，不做订阅（降低决策成本与对账负担）
#
#   体验价   ¥49   / 1 次   —— 首次尝鲜，每人限 1 次（获客钩子）
#   标准价   ¥199  / 1 次   —— 常规单次诊断
#   包 5 次  ¥799  / 5 次   —— 约 ¥160/次，锁定复购（额度长期有效）
#
# 金额单位：分（避免浮点误差）
PRICE_TRIAL_CENTS=4900
PRICE_SINGLE_CENTS=19900
PRICE_PACK5_CENTS=79900

TRIAL_ONCE_PER_USER=true              # 体验价每人限购一次
SIGNUP_FREE_CREDITS=1                 # 注册赠送诊断次数（获客钩子；0 = 关闭）
PACK5_VALID_DAYS=180                  # 5 次包批次有效期（0 = 永久）
CREDIT_EXPIRE_DAYS=365                # 其余额度批次有效期（0 = 永久）
MAX_AUTO_REFUNDS_PER_DAY=10           # 同租户 24h 自动退款上限，超限转人工

# 超级管理员邮箱（逗号分隔）：诊断不限次数，仅测试/演示用。
# 空 = 功能关闭。只免额度：成本熔断/质量门/沙箱照常。撤销需移除此处
# 并执行 UPDATE users SET role='owner' WHERE email='...'（两步缺一不可）。
SUPER_ADMIN_EMAILS=

# Agent 对话配额：每获得 1 次诊断额度（购买或赠送）附送 N 次 Agent 追问。
# 形态 A（查数问答）永远免费；0 = 关闭限制。admin 不受限。
AGENT_CHATS_PER_CREDIT=5

# 成本护栏（内部熔断，不对外；按月统计，跨月自动重置）
COST_ALERT_CENTS=60                   # 单次诊断成本超过 ¥0.60 告警

# ---------------------------------------------------------------------------
# 速率限制（docs/16 P1-7；进程内滑动窗口，多实例部署需换 Redis）
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RL_REGISTER_PER_HOUR=20               # 每 IP
RL_LOGIN_PER_MINUTE=30                # 每 IP
RL_ASK_PER_MINUTE=30                  # 每租户（Agent 成本闸门）
RL_UPLOAD_PER_MINUTE=30               # 每租户
RL_DIAGNOSIS_PER_MINUTE=10            # 每租户

# 支付渠道：支付宝商户号待申请，当前用人工核销
BILLING_PROVIDER=manual               # manual | alipay
MANUAL_REVIEW_REQUIRED=true           # 人工核销时需人工确认

# 支付宝（商户号申请后填写并切换 BILLING_PROVIDER=alipay）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/api/v1/billing/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/billing/result
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SANDBOX=true

# ---------------------------------------------------------------------------
# 报告
# ---------------------------------------------------------------------------
REPORT_FORMAT=html
REPORT_BRAND_NAME=经营诊断报告
REPORT_TEMPLATE_DIR=./templates/report

# ---------------------------------------------------------------------------
# 邮件与邮箱验证（docs/16 P1-7）
# ---------------------------------------------------------------------------
# 开启 REQUIRE_EMAIL_VERIFICATION 后：注册不立即发放赠送次数，
# 用户点击邮件里的验证链接（前端 /verify-email）成功后才会发放。
# ★ 开启前必须配置 SMTP_HOST / SMTP_FROM，否则启动自检会拒绝启动。
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_TOKEN_EXPIRE_HOURS=24
WEB_BASE_URL=http://127.0.0.1:5173    # 验证邮件链接的前端地址

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@your-domain.com
SMTP_USE_SSL=true                     # true=465 SSL；false=587 STARTTLS
SMTP_TIMEOUT=15

# ---------------------------------------------------------------------------
# 观测
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_DIR=./data/logs
AUDIT_LOG_ENABLED=true              # 审计日志（合规必需）
METRICS_ENABLED=true

# ---------------------------------------------------------------------------
# CORS（前端域名，生产必须是明确域名，禁止 *）
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://127.0.0.1:5173